{
	"name": "saloon-book-server",
	"version": "1.0.0",
	"description": "SalonBook REST API - Express, MongoDB, JWT verification, Stripe",
	"main": "dist/server.js",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsc",
		"start": "node dist/server.js",
		"seed": "tsx src/scripts/seed.ts",
		"typecheck": "tsc --noEmit"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LutfunNaharNisha/saloon-book-server.git"
	},
	"keywords": [
		"salon",
		"booking",
		"express",
		"mongodb",
		"stripe",
		"jwt"
	],
	"type": "commonjs",
	"engines": {
		"node": "22.x"
	},
	"bugs": {
		"url": "https://github.com/LutfunNaharNisha/saloon-book-server/issues"
	},
	"homepage": "https://github.com/LutfunNaharNisha/saloon-book-server#readme",
	"dependencies": {
		"cors": "^2.8.5",
		"dotenv": "^16.4.5",
		"express": "^4.21.0",
		"jose": "^4.15.9",
		"mongodb": "^6.9.0",
		"mongoose": "^8.7.0",
		"stripe": "^17.2.0"
	},
	"devDependencies": {
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/node": "^22.7.4",
		"tsx": "^4.19.1",
		"typescript": "^5.6.2"
	}
}
